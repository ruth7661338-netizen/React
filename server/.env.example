# כתובת מסד הנתונים (מקומי, או MongoDB Atlas בענן)
MONGO_URI=mongodb://127.0.0.1:27017/math-games
# מפתח סודי לחתימת הטוקן - להחליף במחרוזת ארוכה ואקראית
JWT_SECRET=change-me-to-a-long-random-string
# סיסמת המערכת - מורה חייבת להזין אותה בהרשמה (בנוסף לסיסמה האישית שלה)
TEACHER_CODE=teach2026
PORT=5000
# כתובת הקליינט (React) - מותר לגשת לשרת רק ממנה. כמה כתובות מופרדות בפסיק
CLIENT_URL=http://localhost:5173
